# Database (SQLite - no PostgreSQL needed)
DATABASE_URL=sqlite:///./data/deepvue.db

# Mock upstream
MOCK_UPSTREAM_URL=http://localhost:8001
HARD_FAILURE_RATE=0.30
HANG_RATE=0.10
RATE_LIMIT_RATE=0.05

# LLM extraction (OpenAI)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Feature toggles (flip without redeploying)
MODEL_OUTAGE=false
KAVERI_POLICY_VERSION=3.1

# Upstream retry config
UPSTREAM_MAX_RETRIES=3
UPSTREAM_TIMEOUT_SECONDS=10
PROCESSING_TIMEOUT_SECONDS=120
